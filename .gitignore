# Jupyter
.ipynb_checkpoints/

# Data — raw DHS microdata is NOT committed (license forbids redistribution).
# data/raw/README.md IS committed (documents the required files + access workflow).
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
# data/processed/ IS committed (small parquets, no PII)

# Cache (requests-cache SQLite, pickled intermediates)
.cache/
*.sqlite
*.sqlite-journal

# Scratch notebooks
notebooks/_scratch/

